# ---- Copy to .env and fill in. Never commit .env ----

# Public hostname for the VPS (DNS A record must point at the server). Used by Caddy for HTTPS.
DOMAIN=payables.lifeonwalls.co.uk
PUBLIC_BASE_URL=https://payables.lifeonwalls.co.uk

# Claude
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5
AGENT_MODEL=claude-opus-5-5
OPTIMIZER_MODEL=claude-opus-5-5

# Mailbox (read-only IMAP). Google Workspace: enable IMAP + create an App Password for the accounts user.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=accounts@lifeonwalls.co.uk
IMAP_PASSWORD=
IMAP_FOLDERS=INBOX
INITIAL_LOOKBACK_DAYS=60

# Web UI login (single shared account) - use a long random password
WEB_USERNAME=admin
WEB_PASSWORD=
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Read-only /r/<token> report links for the board (no login needed)
PUBLIC_SHARE_LINKS=true

# Telegram: create a bot with @BotFather, then message it and read your chat id from the bot's reply
TELEGRAM_BOT_TOKEN=
# Comma separated: people/groups allowed to talk to the bot
TELEGRAM_ALLOWED_CHAT_IDS=
# Comma separated: who receives the weekly report (defaults to the allowed list)
TELEGRAM_NOTIFY_CHAT_IDS=

# Schedules (cron, Europe/London)
TIMEZONE=Europe/London
INGEST_CRON=0 */2 * * *
REPORT_CRON=0 8 * * mon
IMPROVE_CRON=0 7 * * sun

# Self-improvement: false = a human approves every new playbook version (recommended to start)
AUTO_APPLY_IMPROVEMENTS=false
EVAL_MAX_CASES=40
DEFAULT_PAYMENT_TERMS_DAYS=30
